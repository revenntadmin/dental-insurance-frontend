VITE_API_BASE_URL=http://localhost:3001
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_TENANT_ID=
# Use 127.0.0.1 (not localhost) — Firebase phone MFA rejects localhost for verifyPhoneNumber.
VITE_APP_PUBLIC_URL=http://127.0.0.1:5173
VITE_SENTRY_DSN=
VITE_SKIP_MFA=false
# Local phone MFA testing: add a fictional number in Firebase Console, then set this true.
VITE_FIREBASE_PHONE_AUTH_TESTING=false
# Optional: pre-fill the MFA enroll form during testing (must match Firebase test number).
# VITE_FIREBASE_TEST_PHONE=+16505553434
# Optional: firebase emulators:start --only auth (default port 9099)
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
